# Application Configuration
APP_NAME=general-rag-backend
ENVIRONMENT=development
DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=change-this-in-production-super-secret-key-32bytes!

# CORS Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:3001","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Database Configuration (PostgreSQL with pgvector for production; SQLite default for unit tests/local fallback)
# Production: postgresql+asyncpg://user:password@localhost:5432/general-db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/general-db

# S3 Compatible File Storage
S3_ENDPOINT_URL=https://s3.amazonaws.com
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
S3_BUCKET_NAME=general-rag-documents
S3_REGION=us-east-1

# Mistral OCR API Key
MISTRAL_OCR_API_KEY=your-mistral-ocr-api-key

# OpenRouter Gateway Key & Models
OPENROUTER_API_KEY=your-openrouter-api-key
EMBEDDING_MODEL_PROVIDER=openrouter
EMBEDDING_MODEL_NAME=openai/text-embedding-3-small
LLM_MODEL_NAME=anthropic/claude-3.5-sonnet
